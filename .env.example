# Bot Telegram (dari @BotFather)
BOT_TOKEN=

# ID Telegram admin yang boleh mengatur bot (pisahkan koma). Cek ID di @userinfobot
ADMIN_IDS=123456789

# OPSIONAL — biarkan kosong kalau bot dijadikan admin di channel target (mode bot saja).
# Hanya untuk memantau channel orang lain (bot tidak bisa jadi admin di sana):
# isi TG_API_ID & TG_API_HASH dari my.telegram.org, lalu jalankan: npm run login (TG_SESSION terisi otomatis)
TG_API_ID=
TG_API_HASH=
TG_SESSION=

# Lokasi file data (opsional)
DB_FILE=./data.json

# Zona waktu untuk ringkasan harian & jam di laporan
TZ=Asia/Jakarta
