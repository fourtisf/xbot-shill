# Bot Telegram (dari @BotFather)
BOT_TOKEN=

# ID Telegram admin yang boleh mengatur bot (pisahkan koma). Cek ID di @userinfobot
ADMIN_IDS=123456789

# Akun Telegram "listener" untuk membaca channel target (dari my.telegram.org)
TG_API_ID=
TG_API_HASH=
# Diisi otomatis setelah menjalankan: npm run login
TG_SESSION=

# Lokasi file data (opsional)
DB_FILE=./data.json
